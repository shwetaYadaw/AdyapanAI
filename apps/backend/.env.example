# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
MOBILE_URL=exp://localhost:8081

# ── Database (MySQL ONLY — MongoDB is NOT used) ─────────────────────────────
# This project uses MySQL + Prisma exclusively. MongoDB/Mongoose is REMOVED.
# Do NOT add MONGODB_URI here — it will not be read and may cause confusion.
DATABASE_URL="mysql://root:yourpassword@127.0.0.1:3306/adyapan"

# MySQL connection (used by the raw mysql2 pool in src/config/mysql.ts)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=yourpassword
MYSQL_DATABASE=adyapan

# Redis (optional — app works without it, caching just disabled)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_EMAIL_SECRET=your_email_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
EMAIL_FROM="ADYAPAN <noreply@adyapan.com>"

# OTP (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 (optional alternative to Cloudinary)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=ap-south-1
AWS_S3_BUCKET=adyapan-uploads

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=internal_api_key

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Certificate
CERTIFICATE_SECRET=your_certificate_secret

# Judge0 Code Execution
# For self-hosted: http://localhost:2358 (no key required)
# For RapidAPI: https://judge0-extra-clean.p.rapidapi.com
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=
