# Server Configuration
NODE_ENV=development
PORT=8001
API_KEY=your_secure_api_key_here

# Redis Configuration (for Queue Management)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Resource Limits
DEFAULT_CPU_TIME_LIMIT=5
DEFAULT_MEMORY_LIMIT=256
DEFAULT_MAX_PROCESSES=20
DEFAULT_MAX_FILE_SIZE=10

# Docker Configuration
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_NETWORK=execution-network
AUTO_CLEANUP=true
CLEANUP_INTERVAL=300000

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/execution-engine.log

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Backend API Configuration (for callbacks)
BACKEND_API_URL=http://localhost:5000
BACKEND_API_KEY=your_backend_api_key_here
