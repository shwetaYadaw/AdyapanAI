{
  "name": "@adyapan/execution-engine",
  "version": "1.0.0",
  "description": "Production-grade online code execution and judging system for Adyapan AI DSA Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "jest --forceExit",
    "docker:build-runners": "node scripts/build-docker-images.js",
    "docker:clean": "docker system prune -af --filter \"label=adyapan-runner=true\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.4.5",
    "winston": "^3.13.0",
    "dockerode": "^4.0.2",
    "bull": "^4.12.2",
    "ioredis": "^5.3.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.2",
    "@types/uuid": "^10.0.0",
    "@types/dockerode": "^3.3.23",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
