{
  "buildCommand": "yarn workspace @adyapan/web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "yarn install --frozen-lockfile",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "env": {
    "VITE_API_URL": "@adyapan-api-url",
    "VITE_GOOGLE_CLIENT_ID": "@adyapan-google-client-id",
    "VITE_CLOUDINARY_CLOUD_NAME": "@adyapan-cloudinary-cloud-name",
    "VITE_RAZORPAY_KEY_ID": "@adyapan-razorpay-key-id"
  }
}
