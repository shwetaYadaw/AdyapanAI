{
  "name": "adyapan",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w @adyapan/frontend",
    "dev:backend": "npm run dev -w @adyapan/backend",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm run build -w @adyapan/frontend",
    "build:backend": "npm run build -w @adyapan/backend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "setup-hooks": "cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit && echo '✅ Git hooks installed'",
    "check:mysql-only": "node scripts/check-mysql-only.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0"
  },
  "dependencies": {
    "semver": "^7.8.5"
  }
}
