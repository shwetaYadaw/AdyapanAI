#!/bin/sh
# ============================================================
# ADYAPAN — Pre-commit Hook: MySQL-Only Architecture Guard
# ============================================================
# This hook PREVENTS commits that contain MongoDB/Mongoose code.
# The project uses MySQL + Prisma EXCLUSIVELY.
#
# Installation (run once from repo root):
#   cp scripts/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
# ============================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "${YELLOW}🛡️  ADYAPAN Architecture Guard: Checking for MongoDB/Mongoose...${NC}"

ERRORS=0

# 1. Check for mongoose imports in staged TypeScript files
MONGOOSE_IMPORTS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.ts$' | xargs grep -l "from 'mongoose'" 2>/dev/null)
if [ -n "$MONGOOSE_IMPORTS" ]; then
  echo "${RED}❌ BLOCKED: mongoose import detected in:${NC}"
  echo "$MONGOOSE_IMPORTS"
  echo "${RED}   → This project uses MySQL + Prisma ONLY. Use: import { prisma } from '../config/prisma'${NC}"
  ERRORS=$((ERRORS + 1))
fi

# 2. Check for Mongoose model file imports
MODEL_IMPORTS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.ts$' | xargs grep -l "from '.*models/" 2>/dev/null)
if [ -n "$MODEL_IMPORTS" ]; then
  echo "${RED}❌ BLOCKED: Mongoose model import detected in:${NC}"
  echo "$MODEL_IMPORTS"
  echo "${RED}   → Mongoose models are REMOVED. Use prisma.* queries instead.${NC}"
  ERRORS=$((ERRORS + 1))
fi

# 3. Check if mongoose is being added back to package.json
PACKAGE_STAGED=$(git diff --cached --name-only | grep "package.json")
if [ -n "$PACKAGE_STAGED" ]; then
  if git diff --cached -- "apps/backend/package.json" | grep '^\+' | grep '"mongoose"'; then
    echo "${RED}❌ BLOCKED: 'mongoose' is being added to package.json!${NC}"
    echo "${RED}   → This project uses MySQL + Prisma ONLY. Do not add mongoose.${NC}"
    ERRORS=$((ERRORS + 1))
  fi
fi

# 4. Check if MONGODB_URI is being added to .env files
ENV_STAGED=$(git diff --cached --name-only | grep -E '\.env')
if [ -n "$ENV_STAGED" ]; then
  if git diff --cached -- "apps/backend/.env" "apps/backend/.env.example" 2>/dev/null | grep '^\+' | grep 'MONGODB_URI='; then
    echo "${RED}❌ BLOCKED: MONGODB_URI is being added to an .env file!${NC}"
    echo "${RED}   → This project is MySQL-only. Use DATABASE_URL instead.${NC}"
    ERRORS=$((ERRORS + 1))
  fi
fi

# 5. Check for new files being created in the models/ directory
NEW_MODEL_FILES=$(git diff --cached --name-only --diff-filter=A | grep "apps/backend/src/models/")
if [ -n "$NEW_MODEL_FILES" ]; then
  echo "${RED}❌ BLOCKED: New file(s) being added to src/models/ directory:${NC}"
  echo "$NEW_MODEL_FILES"
  echo "${RED}   → Mongoose model files are BANNED. Define schema in prisma/schema.prisma instead.${NC}"
  ERRORS=$((ERRORS + 1))
fi

if [ $ERRORS -gt 0 ]; then
  echo ""
  echo "${RED}═══════════════════════════════════════════════════════════${NC}"
  echo "${RED}  COMMIT REJECTED — MongoDB/Mongoose code detected         ${NC}"
  echo "${RED}  ADYAPAN uses MySQL + Prisma EXCLUSIVELY                  ${NC}"
  echo "${RED}  Fix the issues above and try again.                      ${NC}"
  echo "${RED}═══════════════════════════════════════════════════════════${NC}"
  exit 1
fi

echo "${GREEN}✅ Architecture guard passed — No MongoDB/Mongoose code detected.${NC}"
exit 0
