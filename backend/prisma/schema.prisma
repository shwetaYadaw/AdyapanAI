datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── User & Auth ────────────────────────────────────────────────────────────

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  password        String?
  firstName       String
  lastName        String
  role            String          @default("student") // "student" | "admin"
  isVerified      Boolean         @default(false)
  isEmailVerified Boolean         @default(false)
  isActive        Boolean         @default(true)
  avatar          String?
  googleId        String?         @unique
  phone           String?
  phoneVerified   Boolean         @default(false)
  lastLogin       DateTime?
  loginCount      Int             @default(0)
  deviceTokens    Json?
  preferences     Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  studentProfile      StudentProfile?
  problemSubmissions  ProblemSubmission[]
  questionSubmissions QuestionSubmission[]
  badges              Badge[]
  notifications       Notification[]
  auditLogs           AuditLog[]
}

model StudentProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp             Int       @default(0)
  totalXP        Int       @default(0)
  level          Int       @default(1)
  streak         Int       @default(0)
  lastActiveDate DateTime?
  course         String?   // Job role / course selection (e.g., "data-science", "full-stack-developer")
  skills         Json?
  resumeUrl      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─── Coding Arena (Problem table) ───────────────────────────────────────────

model Problem {
  id                 String              @id @default(uuid())
  title              String
  slug               String              @unique
  difficulty         String              @default("easy")
  courseId           String?             // Links problem to a specific course
  statement          String              @db.Text
  constraints        String              @db.Text
  inputFormat        String              @db.Text
  outputFormat       String              @db.Text
  timeLimit          Int                 @default(2000)
  memoryLimit        Int                 @default(256)
  starterCode        Json
  referenceSolution  String              @db.Text
  topics             String              @db.Text
  companies          String              @db.Text
  tags               String              @db.Text @default("")
  category           String              @default("general")
  successRate        Float               @default(0)
  totalAttempts      Int                 @default(0)
  totalAccepted      Int                 @default(0)
  averageRuntime     Int                 @default(0)
  createdBy          String?
  updatedBy          String?
  isArchived         Boolean             @default(false)
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  testCases          ProblemTestCase[]
  problemSubmissions ProblemSubmission[]
  solutions          ProblemSolution[]
  versionHistory     ProblemVersion[]

  @@index([courseId])
}

model ProblemTestCase {
  id             String   @id @default(uuid())
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String   @db.Text
  expectedOutput String   @db.Text
  isHidden       Boolean  @default(true)
  type           String   @default("hidden")
  explanation    String?  @db.Text
  order          Int      @default(0)
  createdAt      DateTime @default(now())
}

model ProblemSubmission {
  id                      String                   @id @default(uuid())
  userId                  String
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId               String
  problem                 Problem                  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  code                    String                   @db.Text
  language                String
  status                  String                   @default("pending")
  errorMessage            String?                  @db.Text
  runtime                 Int                      @default(0)
  passedCount             Int                      @default(0)
  totalCount              Int                      @default(0)
  problemSubmissionResult ProblemSubmissionResult?
  createdAt               DateTime                 @default(now())
}

model ProblemSubmissionResult {
  id                  String            @id @default(uuid())
  problemSubmissionId String            @unique
  problemSubmission   ProblemSubmission @relation(fields: [problemSubmissionId], references: [id], onDelete: Cascade)
  status              String
  errorMessage        String?           @db.Text
  runtime             Int               @default(0)
  memory              Int               @default(0)
  passedCount         Int               @default(0)
  totalCount          Int               @default(0)
  score               Int               @default(0)
  createdAt           DateTime          @default(now())
}

model ProblemSolution {
  id              String   @id @default(uuid())
  problemId       String
  problem         Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  code            String   @db.Text
  language        String
  approach        String   @db.Text
  timeComplexity  String   @default("O(n)")
  spaceComplexity String   @default("O(1)")
  explanation     String   @db.Text
  isOptimal       Boolean  @default(false)
  rating          Float    @default(0)
  createdBy       String?
  versionNumber   Int      @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProblemVersion {
  id           String   @id @default(uuid())
  problemId    String
  problem      Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  versionNum   Int
  title        String
  statement    String   @db.Text
  difficulty   String
  changes      Json
  changedBy    String?
  changeReason String?  @db.Text
  createdAt    DateTime @default(now())

  @@unique([problemId, versionNum])
}

// ─── TCS NQT ────────────────────────────────────────────────────────────────

model TcsNqtQuestion {
  id                String   @id @default(uuid())
  title             String
  slug              String   @unique
  statement         String   @db.Text
  difficulty        String   @default("easy")
  courseId          String?  // Links question to a specific course
  topic             String
  companies         String   @default("TCS")
  timeLimit         Int      @default(2000)
  memoryLimit       Int      @default(256)
  inputFormat       String   @db.Text
  outputFormat      String   @db.Text
  constraints       String   @db.Text
  referenceSolution String   @db.Text
  testCases         Json?
  xpReward          Int      @default(10)
  experienceLevel   String   @default("freshers") // "freshers" | "experienced"
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  submissions QuestionSubmission[]

  @@index([topic])
  @@index([courseId])
  @@index([difficulty])
  @@index([experienceLevel])
}

model QuestionSubmission {
  id           String                    @id @default(uuid())
  userId       String
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId   String
  question     TcsNqtQuestion            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  code         String                    @db.Text
  language     String
  status       String                    @default("pending")
  errorMessage String?                   @db.Text
  runtime      Int                       @default(0)
  passedCount  Int                       @default(0)
  totalCount   Int                       @default(0)
  result       QuestionSubmissionResult?
  createdAt    DateTime                  @default(now())
}

model QuestionSubmissionResult {
  id                   String             @id @default(uuid())
  questionSubmissionId String             @unique
  questionSubmission   QuestionSubmission @relation(fields: [questionSubmissionId], references: [id], onDelete: Cascade)
  status               String
  errorMessage         String?            @db.Text
  runtime              Int                @default(0)
  memory               Int                @default(0)
  passedCount          Int                @default(0)
  totalCount           Int                @default(0)
  score                Int                @default(0)
  createdAt            DateTime           @default(now())
}

// ─── Aptitude ────────────────────────────────────────────────────────────────

model AptitudeAdminQuestion {
  id                String   @id @default(uuid())
  title             String
  slug              String   @unique
  statement         String   @db.Text
  difficulty        String   @default("easy")
  topic             String
  companies         String   @db.Text
  inputFormat       String   @db.Text
  outputFormat      String   @db.Text
  constraints       String   @db.Text
  referenceSolution String   @db.Text
  xpReward          Int      @default(10)
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([topic])
  @@index([difficulty])
}

// ─── Hierarchical Aptitude System (Topic → Chapter → Question with MCQ) ──────

model AptitudeTopic {
  id          String                @id @default(uuid())
  name        String                @unique
  description String?               @db.Text
  icon        String?
  order       Int                   @default(0)
  isActive    Boolean               @default(true)
  createdBy   String?
  updatedAt   DateTime              @updatedAt
  createdAt   DateTime              @default(now())

  chapters    AptitudeChapter[]
}

model AptitudeChapter {
  id          String                @id @default(uuid())
  topicId     String
  topic       AptitudeTopic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name        String
  description String?               @db.Text
  order       Int                   @default(0)
  isActive    Boolean               @default(true)
  createdBy   String?
  updatedAt   DateTime              @updatedAt
  createdAt   DateTime              @default(now())

  questions   AptitudeQuestion[]

  @@unique([topicId, name])
  @@index([topicId])
}

model AptitudeQuestion {
  id             String                @id @default(uuid())
  chapterId      String
  chapter        AptitudeChapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  statement      String                @db.Text
  difficulty     String                @default("medium")
  correctOption  String                // "A" | "B" | "C" | "D"
  explanation    String?               @db.Text
  xpReward       Int                   @default(10)
  companies      String?
  timeLimit      Int                   @default(30)
  isActive       Boolean               @default(true)
  createdBy      String?
  updatedBy      String?
  updatedAt      DateTime              @updatedAt
  createdAt      DateTime              @default(now())

  options        AptitudeOption[]
  submissions    AptitudeSubmission[]

  @@index([chapterId])
  @@index([difficulty])
}

model AptitudeOption {
  id         String                @id @default(uuid())
  questionId String
  question   AptitudeQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionKey  String                // "A" | "B" | "C" | "D"
  text       String                @db.Text
  isCorrect  Boolean               @default(false)
  order      Int                   @default(0)
  createdAt  DateTime              @default(now())

  @@unique([questionId, optionKey])
  @@index([questionId])
}

model AptitudeSubmission {
  id           String                @id @default(uuid())
  userId       String?
  questionId   String
  question     AptitudeQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption String?             // "A" | "B" | "C" | "D"
  isCorrect    Boolean               @default(false)
  timeSpent    Int?                  // seconds
  xpEarned     Int                   @default(0)
  createdAt    DateTime              @default(now())

  @@index([userId])
  @@index([questionId])
}

model AptitudeTest {
  id         String   @id @default(uuid())
  title      String
  category   String?
  difficulty String?
  duration   Int?
  questions  Json?
  totalMarks Int?
  company    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Topic Management ────────────────────────────────────────────────────────

model Topic {
  id          String   @id @default(uuid())
  name        String
  system      String   // "coding-arena" | "tcs-nqt" | "aptitude"
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, system])
  @@index([system])
}

// ─── Contests ────────────────────────────────────────────────────────────────

model Contest {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  startTime   DateTime
  endTime     DateTime
  questions   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Code Execution ──────────────────────────────────────────────────────────

model Language {
  id             String   @id @default(uuid())
  name           String   @unique
  compileCommand String?
  runCommand     String
  dockerImage    String
  createdAt      DateTime @default(now())
}

model ExecutionQueue {
  id           String   @id @default(uuid())
  submissionId String
  status       String   @default("queued")
  priority     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ExecutionLog {
  id           String   @id @default(uuid())
  submissionId String
  logMessage   String   @db.Text
  createdAt    DateTime @default(now())
}

// ─── Gamification ────────────────────────────────────────────────────────────

model Badge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeType   String
  name        String
  description String?  @db.Text
  iconUrl     String
  metadata    Json?
  unlockedAt  DateTime @default(now())
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String?
  title     String
  message   String?   @db.Text
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  channel   String    @default("in-app")
  createdAt DateTime  @default(now())
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String?
  resourceId String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}
