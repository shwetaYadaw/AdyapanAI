{
  "name": "@adyapan/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "jest --forceExit",
    "create:admin": "npx ts-node --transpile-only scripts/create-admin.ts",
    "check:admin": "npx ts-node --transpile-only scripts/check-admin.ts",
    "reset:admin": "npx ts-node --transpile-only scripts/reset-admin-password.ts",
    "verify:admin": "npx ts-node --transpile-only scripts/verify-admin-password.ts",
    "migrate:roles": "npx ts-node --transpile-only scripts/migrate-roles.ts",
    "seed": "npx ts-node --transpile-only src/scripts/seed.ts",
    "seed:challenges": "npx ts-node --transpile-only src/scripts/seedChallenges.ts",
    "seed:tcs": "npx ts-node --transpile-only src/scripts/seedTcsNqt.ts",
    "seed:tcs-json": "npx ts-node --transpile-only src/scripts/seedTcsNqtFromJson.ts",
    "seed:tcs-reasoning": "npx ts-node --transpile-only src/scripts/seedTcsReasoningAptitude.ts",
    "seed:tcs-seating": "npx ts-node --transpile-only src/scripts/seedTcsSeatingArrangement.ts",
    "seed:tcs-circular": "npx ts-node --transpile-only src/scripts/seedTcsSeatingComprehensive.ts",
    "seed:tcs-nonverbal": "npx ts-node --transpile-only src/scripts/seedTcsNonVerbalReasoning.ts",
    "seed:mysql": "npx ts-node --transpile-only src/scripts/seedMysql.ts",
    "seed:all-questions": "npx ts-node --transpile-only src/scripts/seedAllQuestionsFromJson.ts",
    "seed:all": "npm run seed && npm run seed:mysql && npm run seed:challenges && npm run seed:tcs && npm run seed:tcs-reasoning && npm run seed:tcs-seating && npm run seed:tcs-circular",
    "migrate:questions": "npm run seed:all-questions",
    "reset:seed:questions": "npm run seed:all-questions",
    "migrate:questions-to-problems": "npx ts-node --transpile-only src/scripts/migrateQuestionsToProblem.ts",
    "clean:reseed": "npx ts-node --transpile-only src/scripts/cleanAndReseed.ts",
    "fresh:seed": "npx ts-node --transpile-only src/scripts/freshSeed.ts",
    "delete:non-tcs-nqt": "npx ts-node --transpile-only src/scripts/deleteNonTcsNqtQuestions.ts",
    "analyze:questions": "npx ts-node --transpile-only src/scripts/analyzeQuestionTable.ts",
    "backup:problems": "npx ts-node --transpile-only src/scripts/backupProblems.ts",
    "verify:data": "npx ts-node --transpile-only src/scripts/verifyDataIntegrity.ts",
    "seed:coding-arena": "npx ts-node --transpile-only scripts/seed-coding-arena-problems.ts",
    "seed:topics": "npx ts-node --transpile-only scripts/seed-topics.ts",
    "check:problems": "npx ts-node --transpile-only scripts/check-problems-status.ts",
    "fix:schema": "npx ts-node --transpile-only scripts/fix-problem-schema.ts",
    "build:docker-runners": "node scripts/build-docker-images.js"
  },
  "dependencies": {
    "@adyapan/shared": "*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "^7.9.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.2",
    "cloudinary": "^2.2.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "google-auth-library": "^9.11.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.23.0",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.15.0",
    "pg": "8.22.0",
    "qrcode": "^1.5.3",
    "razorpay": "^2.9.2",
    "slugify": "^1.6.6",
    "stripe": "^15.10.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "xss-clean": "^0.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.31",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "^0.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "prisma": "^7.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
